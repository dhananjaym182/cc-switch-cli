# Application
NODE_ENV=development
PORT=3010
HOST=0.0.0.0

# Frontend
FRONTEND_URL=http://localhost:5173

# Database (Phase 1: SQLite, Phase 2: PostgreSQL)
DATABASE_TYPE=sqlite
DATABASE_URL=file:./data/cc-switch.db
# DATABASE_URL=postgresql://user:password@localhost:5432/ccswitch

# Security
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRATION=24h
JWT_REFRESH_SECRET=your-refresh-token-secret-change-this
JWT_REFRESH_EXPIRATION=7d

# Encryption
ENCRYPTION_KEY=your-32-character-encryption-key-here

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Logging
LOG_LEVEL=debug
LOG_FILE=logs/app.log

# cc-switch CLI
CC_SWITCH_PATH=cc-switch
CC_SWITCH_CONFIG_HOME=~/.cc-switch

# Health Checks
HEALTH_CHECK_INTERVAL=30000

# Backup
AUTO_BACKUP_ENABLED=true
BACKUP_RETENTION_DAYS=30

# WebSocket
WS_PORT=3010
WS_PATH=/ws

# RightStockAI Integration
RIGHTSTOCKAI_ENABLED=true
RIGHTSTOCKAI_API_KEY=
RIGHTSTOCKAI_ENDPOINT=

# Monitoring (Optional)
ENABLE_METRICS=true
METRICS_PORT=9090
